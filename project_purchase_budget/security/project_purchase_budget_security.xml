<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_purchase_budget_manager" model="res.groups">
        <field name="name">Project Purchase Budget Manager</field>
        <field name="category_id" ref="base.module_category_services_project" />
        <field
            name="comment"
        >Can set the purchase budget percentage and sale override on projects. Also reviews purchase orders that exceed the project purchase budget.</field>
    </record>

    <!-- Project managers can manage purchase budgets by default -->
    <record id="project.group_project_manager" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('project_purchase_budget.group_purchase_budget_manager'))]"
        />
    </record>
</odoo>
