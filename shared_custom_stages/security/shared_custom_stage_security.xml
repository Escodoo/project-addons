<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="rule_shared_custom_stage_multi_company" model="ir.rule">
        <field name="name">Shared Custom Stage Multi-Company</field>
        <field name="model_id" ref="model_shared_custom_stage" />
        <field name="domain_force">
            ["|", ("company_id", "=", False), ("company_id", "in", company_ids)]
        </field>
    </record>

    <record id="rule_unified_task_ticket_multi_company" model="ir.rule">
        <field name="name">Unified Task Ticket Multi-Company</field>
        <field name="model_id" ref="model_unified_task_ticket" />
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
    </record>
</odoo>
