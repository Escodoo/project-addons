<odoo>
    <record id="view_shared_custom_stage_tree" model="ir.ui.view">
        <field name="name">shared.custom.stage.tree</field>
        <field name="model">shared.custom.stage</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
                <field name="active" widget="boolean_toggle" />
                <field name="is_default" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <record id="view_shared_custom_stage_form" model="ir.ui.view">
        <field name="name">shared.custom.stage.form</field>
        <field name="model">shared.custom.stage</field>
        <field name="arch" type="xml">
            <form string="Custom Stage">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. In Progress" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence" />
                            <field name="is_default" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                            />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shared_custom_stage" model="ir.actions.act_window">
        <field name="name">Custom Stages</field>
        <field name="res_model">shared.custom.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_shared_custom_stage_config"
        name="Custom Stages"
        parent="project.menu_project_config"
        action="action_shared_custom_stage"
        sequence="30"
    />
</odoo>
